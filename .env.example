# ─────────────────────────────────────────────
# File Analyzer
# ─────────────────────────────────────────────
SCAN_DIR=/data

# ─────────────────────────────────────────────
# Database (для db_backup_to_b2.py)
# ─────────────────────────────────────────────
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=test_db
DB_USER=test_user
DB_PASSWORD=test_password

# ─────────────────────────────────────────────
# Backblaze B2 (для db_backup_to_b2.py)
# ─────────────────────────────────────────────
B2_KEY_ID=test_key_id
B2_APPLICATION_KEY=test_application_key
B2_BUCKET_NAME=test-bucket
B2_ENDPOINT=https://s3.eu-central-003.backblazeb2.com